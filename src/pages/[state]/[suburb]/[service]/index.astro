---
import Layout from '../../../../layouts/Layout.astro';
import directoryData from '../../../../data/suburbs.json';

export async function getStaticPaths() {
  const paths: any[] = [];
  
  directoryData.forEach((item: any) => {
    if (item.state && item.suburb && item.services) {
      item.services.forEach((service: string) => {
        paths.push({
          params: {
            state: item.state.toLowerCase(),
            suburb: item.suburb.toLowerCase(),
            service: service.toLowerCase().replace(/\s+/g, '-')
          },
          props: {
            serviceName: service,
            suburbName: item.suburb,
            stateName: item.state,
            listings: directoryData.filter((d: any) => 
              d.state?.toLowerCase() === item.state?.toLowerCase() &&
              d.suburb?.toLowerCase() === item.suburb?.toLowerCase() &&
              (d.services || []).some((s: string) => s.toLowerCase() === service.toLowerCase())
            )
          }
        });
      });
    }
  });

  return paths;
}

const { serviceName, suburbName, stateName, listings } = Astro.props;
---

<Layout
  title={`${serviceName} in ${suburbName}, ${stateName?.toUpperCase()} | DieselHub`}
  description={`Find heavy vehicle ${serviceName} providers in ${suburbName}, ${stateName?.toUpperCase()}. Verified workshop facilities and emergency mobile mechanics.`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8 font-sans">
    <div class="border-b border-zinc-800 pb-6">
      <span class="text-xs font-mono text-amber-500 uppercase tracking-widest">{stateName?.toUpperCase()} · {suburbName}</span>
      <h1 class="text-3xl font-black font-mono tracking-tight text-slate-100 mt-1">
        {serviceName} in <span class="text-amber-500">{suburbName}</span>
      </h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {listings.map((item: any) => (
        <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-5 space-y-3">
          <h2 class="text-lg font-bold text-slate-100">{item.name}</h2>
          <p class="text-xs text-slate-400">{item.address || `${item.suburb}, ${item.state}`}</p>
          {item.phone && (
            <a href={`tel:${item.phone}`} class="inline-block text-xs font-mono font-bold text-amber-400 hover:text-amber-300">
              📞 {item.phone}
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</Layout>
