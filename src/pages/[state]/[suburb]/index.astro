---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import directoryData from '../../../data/suburbs.json';

export async function getStaticPaths() {
  const suburbsMap = new Map();

  directoryData.forEach((item: any) => {
    if (item.state && item.suburb) {
      const key = `${item.state.toLowerCase()}/${item.suburb.toLowerCase()}`;
      if (!suburbsMap.has(key)) {
        suburbsMap.set(key, {
          state: item.state.toLowerCase(),
          suburb: item.suburb.toLowerCase(),
          stateName: item.state,
          suburbName: item.suburb,
          listings: []
        });
      }
      suburbsMap.get(key).listings.push(item);
    }
  });

  return Array.from(suburbsMap.values()).map(entry => ({
    params: { state: entry.state, suburb: entry.suburb },
    props: {
      stateName: entry.stateName,
      suburbName: entry.suburbName,
      listings: entry.listings
    }
  }));
}

const { stateName, suburbName, listings } = Astro.props;
---

<Layout
  title={`Diesel Mechanics & Heavy Vehicle Repairers in ${suburbName}, ${stateName?.toUpperCase()} | DieselHub`}
  description={`Find heavy vehicle workshops, mobile diesel breakdown services, and trailer repair facilities in ${suburbName}, ${stateName?.toUpperCase()}.`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8 font-sans">
    <div class="border-b border-zinc-800 pb-6">
      <span class="text-xs font-mono text-amber-500 uppercase tracking-widest">{stateName?.toUpperCase()} Regional Hub</span>
      <h1 class="text-3xl font-black font-mono tracking-tight text-slate-100 mt-1">
        Diesel Mechanics in <span class="text-amber-500">{suburbName}</span>
      </h1>
      <p class="text-sm text-slate-400 mt-2">
        Verified heavy transport workshops, emergency road service, and mobile linehaul mechanics.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {listings.map((item: any) => (
        <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-5 space-y-3">
          <div class="flex justify-between items-start gap-2">
            <h2 class="text-lg font-bold text-slate-100">{item.name}</h2>
            {item.suburb && (
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-zinc-800 text-amber-400 shrink-0">
                {item.suburb}
              </span>
            )}
          </div>
          <p class="text-xs text-slate-400">{item.address || `${item.suburb}, ${item.state}`}</p>
          {item.phone && (
            <a href={`tel:${item.phone}`} class="inline-block text-xs font-mono font-bold text-amber-400 hover:text-amber-300">
              📞 {item.phone}
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</Layout>
