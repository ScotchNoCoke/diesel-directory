---
import { env } from 'cloudflare:workers';

export const prerender = false;
import Layout from '../../layouts/Layout.astro';

let error = '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const passkey = data.get('passkey')?.toString().trim();
    const expected = env.ADMIN_SECRET || 'dieselhub-admin-secret-2026';

    if (passkey !== undefined && passkey === expected) {
      Astro.cookies.set('dh_admin_session', passkey, {
        path: '/',
        httpOnly: true,
        secure: true,
        sameSite: 'strict',
        maxAge: 60 * 60 * 24 * 7
      });
      return Astro.redirect('/admin');
    } else {
      error = 'Invalid Master Passkey';
    }
  } catch (err: any) {
    error = err.message;
  }
}
---

<Layout title="Master Admin Login | DieselHub">
  <div class="min-h-[70vh] flex items-center justify-center px-4">
    <div class="w-full max-w-md bg-zinc-900 border border-zinc-800 rounded-2xl p-8 shadow-2xl space-y-6">
      <div class="text-center space-y-2">
        <span class="inline-block px-3 py-1 bg-amber-500/10 border border-amber-500/20 text-amber-500 text-xs font-mono font-bold uppercase tracking-widest rounded">
          Restricted Area
        </span>
        <h1 class="text-2xl font-bold font-mono text-zinc-100">Master Admin Access</h1>
        <p class="text-sm text-zinc-400">Enter master authorization passkey to continue</p>
      </div>

      {error && (
        <div class="p-3 bg-red-900/30 border border-red-800 text-red-300 text-sm rounded-lg text-center font-mono">
          {error}
        </div>
      )}

      <form method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-mono text-zinc-400 mb-1.5 uppercase">Master Passkey</label>
          <input 
            type="password" 
            name="passkey" 
            required 
            placeholder="••••••••••••••••"
            class="w-full px-4 py-2.5 rounded-xl bg-zinc-950 border border-zinc-800 text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-amber-500 font-mono"
          />
        </div>

        <button 
          type="submit" 
          class="w-full py-3 bg-amber-500 hover:bg-amber-400 text-zinc-950 font-bold font-mono rounded-xl transition shadow-lg shadow-amber-500/20"
        >
          Authenticate Master Session
        </button>
      </form>
    </div>
  </div>
</Layout>
