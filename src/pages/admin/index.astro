---
import { env } from 'cloudflare:workers';

export const prerender = false;

type ContactRecord = {
  id: string;
  created_at: string;
  category: string;
  name: string;
  company_name: string | null;
  email: string;
  phone: string | null;
  message: string;
  status: string;
};

let contacts: ContactRecord[] = [];
let error = null;

if (env?.DB) {
  try {
    const { results } = await env.DB.prepare(
      'SELECT * FROM admin_contacts ORDER BY created_at DESC LIMIT 100'
    ).all<ContactRecord>();
    contacts = results || [];
  } catch (e: any) {
    error = e.message;
  }
}
---

<!DOCTYPE html>
<html lang="en" class="bg-[#0b0c10] text-[#e0e2ec]">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Centre | Contact Triage | Diesel Hub</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-[#0a0a0c] text-neutral-200 antialiased font-sans">
  <div class="border-b border-neutral-800 bg-[#121316] px-6 py-4 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <span class="inline-block w-3 h-3 bg-amber-500 rounded-sm"></span>
      <h1 class="text-lg font-mono font-bold tracking-wider uppercase text-white">Diesel Hub // Admin Centre</h1>
      <span class="text-xs px-2 py-0.5 rounded bg-neutral-800 text-neutral-400 font-mono">Operations</span>
    </div>
    <div class="flex items-center gap-4 text-xs font-mono">
      <span class="text-emerald-400">● LIVE</span>
      <a href="/" class="text-neutral-400 hover:text-white transition">Exit to Directory ↗</a>
    </div>
  </div>

  <main class="max-w-7xl mx-auto px-6 py-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 border-b border-neutral-800 gap-4">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-white">Inbound Contacts & Callout Triage</h2>
        <p class="text-sm text-neutral-400 mt-1">Review fleet inquiries, emergency dispatch requests, and workshop claims.</p>
      </div>
      <div class="flex gap-2">
        <button onclick="window.location.reload()" class="px-3 py-1.5 bg-neutral-800 hover:bg-neutral-700 text-xs font-mono font-medium rounded border border-neutral-700 transition">
          Refresh Queue
        </button>
      </div>
    </div>

    {error && (
      <div class="mt-6 p-4 bg-red-950/40 border border-red-800/80 rounded text-red-200 text-sm font-mono">
        Failed to fetch records: {error}
      </div>
    )}

    <div class="mt-6 overflow-x-auto rounded border border-neutral-800 bg-[#111215]">
      <table class="w-full text-left text-sm">
        <thead class="bg-[#17191d] border-b border-neutral-800 text-xs uppercase font-mono text-neutral-400">
          <tr>
            <th class="py-3.5 px-4">Timestamp</th>
            <th class="py-3.5 px-4">Category</th>
            <th class="py-3.5 px-4">Contact</th>
            <th class="py-3.5 px-4">Message</th>
            <th class="py-3.5 px-4">Status</th>
            <th class="py-3.5 px-4 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-800/60 font-sans">
          {contacts.length === 0 ? (
            <tr>
              <td colspan="6" class="text-center py-10 text-neutral-500 font-mono text-sm">
                No inbound triage items found.
              </td>
            </tr>
          ) : (
            contacts.map((item: any) => (
              <tr class="hover:bg-neutral-800/30 transition">
                <td class="py-3 px-4 font-mono text-xs text-neutral-400 whitespace-nowrap">
                  {new Date(item.created_at).toLocaleString('en-AU', { timeZone: 'Australia/Melbourne' })}
                </td>
                <td class="py-3 px-4">
                  <span class={`inline-block px-2 py-0.5 text-xs font-mono font-semibold uppercase rounded ${
                    item.category === 'emergency' ? 'bg-red-950 text-red-300 border border-red-800' :
                    item.category === 'quote_callout' ? 'bg-amber-950 text-amber-300 border border-amber-800' :
                    'bg-neutral-800 text-neutral-300 border border-neutral-700'
                  }`}>
                    {item.category.replace('_', ' ')}
                  </span>
                </td>
                <td class="py-3 px-4">
                  <div class="font-medium text-white">{item.name}</div>
                  {item.company_name && <div class="text-xs text-neutral-400">{item.company_name}</div>}
                  <div class="text-xs font-mono text-neutral-400 mt-1 flex gap-2">
                    <a href={`mailto:${item.email}`} class="hover:underline text-amber-400">{item.email}</a>
                    {item.phone && <span>• <a href={`tel:${item.phone}`} class="hover:underline">{item.phone}</a></span>}
                  </div>
                </td>
                <td class="py-3 px-4 max-w-sm truncate text-neutral-300" title={item.message}>
                  {item.message}
                </td>
                <td class="py-3 px-4">
                  <span class={`inline-block px-2 py-0.5 text-xs font-mono rounded ${
                    item.status === 'new' ? 'bg-blue-950 text-blue-300' :
                    item.status === 'in_progress' ? 'bg-amber-950 text-amber-300' :
                    item.status === 'resolved' ? 'bg-emerald-950 text-emerald-300' :
                    'bg-neutral-800 text-neutral-400'
                  }`}>
                    {item.status}
                  </span>
                </td>
                <td class="py-3 px-4 text-right">
                  <button 
                    onclick={`updateStatus('${item.id}', '${item.status === "resolved" ? "new" : "resolved"}')`}
                    class="text-xs font-mono px-2.5 py-1 rounded bg-neutral-800 hover:bg-neutral-700 text-neutral-200 border border-neutral-700 transition"
                  >
                    {item.status === "resolved" ? "Reopen" : "Resolve"}
                  </button>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </main>

  <script is:inline>
    async function updateStatus(id, newStatus) {
      const res = await fetch('/api/admin/contacts', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, status: newStatus })
      });
      if (res.ok) {
        window.location.reload();
      } else {
        alert('Failed to update status');
      }
    }
  </script>
</body>
</html>
