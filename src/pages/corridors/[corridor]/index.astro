---
import Layout from '../../../layouts/Layout.astro';
import directoryData from '../../../data/suburbs.json';

export const prerender = true;

export async function getStaticPaths() {
  const corridors = [...new Set(directoryData.map((item: any) => item.corridor))].filter(Boolean);

  return corridors.map((corridor) => {
    const slug = (corridor as string).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    const matchedSuburbs = directoryData.filter((item: any) => item.corridor === corridor);
    return {
      params: { corridor: slug },
      props: {
        corridorTitle: corridor,
        suburbs: matchedSuburbs,
      },
    };
  });
}

const { corridorTitle, suburbs } = Astro.props;
---

<Layout title={`${corridorTitle} | Diesel Hub Freight Corridors`}>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-8">
      <span class="text-xs font-semibold uppercase tracking-wider text-amber-500">Freight Corridor</span>
      <h1 class="text-3xl font-extrabold text-white mt-1">{corridorTitle}</h1>
      <p class="text-slate-400 mt-2">Specialist heavy vehicle diesel repair centers servicing this transport route.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {suburbs.map((suburb: any) => (
        <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 hover:border-slate-700 transition">
          <h2 class="text-lg font-bold text-slate-100 capitalize">{suburb.suburb}, {suburb.state?.toUpperCase()}</h2>
          <p class="text-xs text-slate-400 mt-1">{suburb.localOverview}</p>
          <div class="mt-4 pt-4 border-t border-slate-800/60 flex items-center justify-between text-xs">
            <span class="text-slate-500 font-mono">Postcode {suburb.postcode}</span>
            <a href={`/${suburb.state?.toLowerCase()}/${suburb.suburb?.toLowerCase()}`} class="text-amber-400 hover:text-amber-300 font-medium">
              View Workshops &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>
  </main>
</Layout>
