---
import Layout from '../../layouts/Layout.astro';
import directoryData from '../../data/directory.json';

export async function getStaticPaths() {
  const corridors = [...new Set(directoryData.flatMap(item => item.corridors || []))].filter(Boolean);
  return corridors.map(corridor => ({
    params: { corridor: corridor.toLowerCase().replace(/\s+/g, '-') },
    props: {
      corridorName: corridor,
      listings: directoryData.filter(item => (item.corridors || []).includes(corridor))
    }
  }));
}

const { corridorName, listings } = Astro.props;
---

<Layout
  title={`${corridorName} Heavy Vehicle Repair & Diesel Mechanics | DieselHub`}
  description={`Find heavy vehicle breakdown services, 24/7 mobile callouts, and workshop bays along the ${corridorName} freight corridor.`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <div class="border-b border-zinc-800 pb-6">
      <span class="text-xs font-mono text-amber-500 uppercase tracking-widest">Freight Corridor Index</span>
      <h1 class="text-3xl font-black font-mono tracking-tight text-slate-100 mt-1">
        {corridorName} <span class="text-amber-500">Service Coverage</span>
      </h1>
      <p class="text-sm text-slate-400 mt-2 font-sans">
        Showing verified heavy vehicle repairers and mobile mechanics along this transit route.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {listings.map((item) => (
        <div class="bg-zinc-900 border border-zinc-800 rounded-lg p-5 space-y-3 font-sans">
          <div class="flex justify-between items-start gap-2">
            <h2 class="text-lg font-bold text-slate-100">{item.name}</h2>
            {item.suburb && (
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-zinc-800 text-amber-400 shrink-0">
                {item.suburb}
              </span>
            )}
          </div>
          <p class="text-xs text-slate-400">{item.address || `${item.suburb}, ${item.state}`}</p>
          {item.phone && (
            <a href={`tel:${item.phone}`} class="inline-block text-xs font-mono font-bold text-amber-400 hover:text-amber-300">
              📞 {item.phone}
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</Layout>
