---
import Layout from "../layouts/Layout.astro";
import { env } from "cloudflare:workers";

export const prerender = false;

const reqUrl = new URL(Astro.request.url);
const token = reqUrl.searchParams.get("token") || "";
const error = reqUrl.searchParams.get("error");
const db = (env as any)?.DB;

let isValidToken = false;

if (token && db) {
  const now = Math.floor(Date.now() / 1000);
  const tokenRecord = await db
    .prepare("SELECT user_id FROM password_reset_tokens WHERE token = ? AND used_at IS NULL AND expires_at > ?")
    .bind(token, now)
    .first();
  isValidToken = Boolean(tokenRecord);
}
---

<Layout title="Set New Password | Diesel Hub">
  <main class="min-h-screen bg-slate-950 text-slate-100 flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl p-8 shadow-2xl">
      <div class="text-center mb-6">
        <h1 class="text-2xl font-black text-white">Create New Password</h1>
        <p class="text-xs text-slate-400 mt-2">Enter your new secure password below.</p>
      </div>

      {!token || (!isValidToken && !error) ? (
        <div class="space-y-4">
          <div class="p-4 bg-red-500/10 border border-red-500/20 rounded-xl text-red-400 text-xs">
            This password reset link is invalid or has expired. Please request a new one.
          </div>
          <a
            href="/forgot-password"
            class="block text-center py-2.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-xl text-xs transition"
          >
            Request New Reset Link &rarr;
          </a>
        </div>
      ) : (
        <form method="POST" action="/api/auth/reset-password" class="space-y-4">
          {error && (
            <div class="p-3 bg-red-500/10 border border-red-500/20 rounded-xl text-red-400 text-xs">
              {error}
            </div>
          )}

          <input type="hidden" name="token" value={token} />

          <div>
            <label for="password" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">New Password</label>
            <input
              id="password"
              type="password"
              name="password"
              minlength="8"
              required
              class="w-full px-4 py-3 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
            />
            <span class="text-[11px] text-slate-500 mt-1 block">Minimum 8 characters.</span>
          </div>

          <div>
            <label for="confirm_password" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Confirm New Password</label>
            <input
              id="confirm_password"
              type="password"
              name="confirm_password"
              minlength="8"
              required
              class="w-full px-4 py-3 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
            />
          </div>

          <button
            type="submit"
            class="w-full py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-xl text-sm transition shadow-lg shadow-amber-500/20 cursor-pointer"
          >
            Save Password & Sign In &rarr;
          </button>
        </form>
      )}
    </div>
  </main>
</Layout>
