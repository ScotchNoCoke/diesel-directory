              <p class="text-xs text-slate-400 mt-1">{chain.description}</p>
            </div>
            <span class="text-xs font-mono text-slate-400 self-start sm:self-auto bg-zinc-950 px-3 py-1 rounded border border-zinc-800">
              {chainSuburbs.length} Staging Hubs
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {chainSuburbs.map(suburb => {
              const count = getSuburbMechanicCount(suburb);
              return (
                <a
                  href={`/suburbs/${suburb.slug}`}
                  class="group block p-5 rounded-lg bg-zinc-950 border border-zinc-800 hover:border-amber-500/60 hover:bg-zinc-900 transition-all flex flex-col justify-between"
                >
                  <div class="space-y-3">
                    <div class="flex items-center justify-between">
                      <h3 class="text-lg font-bold font-mono text-slate-100 group-hover:text-amber-400 transition-colors">
                        {suburb.name}
                      </h3>
                      <span class="text-xs font-mono text-slate-500 bg-zinc-900 px-2 py-0.5 rounded border border-zinc-800">
                        {suburb.postcode}
                      </span>
                    </div>
                    <p class="text-xs text-slate-400 line-clamp-3 leading-relaxed">
                      {suburb.description}
                    </p>
                  </div>

                  <div class="mt-5 pt-3 border-t border-zinc-900 flex items-center justify-between text-xs font-mono">
                    <div class="flex flex-wrap gap-1.5">
                      <span class="text-[10px] px-1.5 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-slate-300">24/7 Units</span>
                      {suburb.bDoubleAccess && (
                        <span class="text-[10px] px-1.5 py-0.5 rounded bg-zinc-900 border border-zinc-800 text-slate-300">B-Double Yard</span>
                      )}
                    </div>
                    <span class="text-amber-500 group-hover:text-amber-400 flex items-center gap-1">
                      {count} Verified &rarr;
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      );
    })}

  </div>
</Layout>

<script>
  const locateBtn = document.getElementById('locate-btn');
  const resultDiv = document.getElementById('location-result');

  locateBtn?.addEventListener('click', () => {
    if (!navigator.geolocation) {
      alert('Geolocation is not supported by your browser.');
      return;
    }

    locateBtn.textContent = 'Scanning Nearest Operators...';
    
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const { latitude, longitude } = pos.coords;
        if (resultDiv) {
          resultDiv.classList.remove('hidden');
          resultDiv.innerHTML = `
            <div class="p-4 rounded bg-zinc-950 border border-amber-500/40 text-xs font-mono text-slate-300 flex items-center justify-between">
              <span>📍 Coordinates: ${latitude.toFixed(4)}, ${longitude.toFixed(4)}</span>
              <span class="text-amber-400 font-bold">Closest Hubs: Laverton North & Truganina (Port Western Belt)</span>
            </div>
          `;
        }
        locateBtn.textContent = '📍 Position Locked';
      },
      () => {
        locateBtn.textContent = '📍 Locate Nearest Operator';
        alert('Could not retrieve location. Please allow GPS permissions or choose your corridor below.');
      }
    );
  });
</script>
