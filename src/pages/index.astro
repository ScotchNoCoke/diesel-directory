---
import DispatchInquiryModal from "../components/DispatchInquiryModal.astro";
import WorkshopCard from "../components/WorkshopCard.astro";
import { env } from "cloudflare:workers";

const claimedProfilesMap = new Map();
try {
  const db = (env as any)?.DB;
  if (db && typeof db.prepare === "function") {
    const query = await db.prepare(
      "SELECT business_id, phone, emergency_phone, is_open_now, b_double_access, road_train_access, drive_through_bays, rwc_licensed FROM workshop_profiles"
    ).all();
    if (query && Array.isArray(query.results)) {
      for (const row of query.results) {
        if (row && row.business_id) {
          claimedProfilesMap.set(row.business_id, row);
        }
      }
    }
  }
} catch (err) {
  console.warn("D1 query fallback:", err);
}
import Layout from '../layouts/Layout.astro';
import MiniMapIcon from '../components/MiniMapIcon.astro';
import suburbs from '../data/suburbs.json';

// Calculate statewide totals
const totalSuburbs = suburbs.length;
const allBusinesses = suburbs.flatMap((s: any) => 
  (s.businesses || []).map((b: any) => ({
    ...b,
    suburbName: s.suburb,
    state: s.state,
    postcode: s.postcode,
    corridor: s.corridor,
  }))
);
const totalMechanics = allBusinesses.length;

// Filter helpers
const metroSuburbs = suburbs.filter((s: any) => 
  ['truganina', 'laverton-north', 'campbellfield', 'dandenong-south', 'bayswater'].includes(s.suburb.toLowerCase().replace(/\s+/g, '-'))
);

const westernSuburbs = suburbs.filter((s: any) => 
  ['ballarat', 'horsham', 'nhill', 'bordertown', 'keith', 'tailem-bend', 'wingfield'].includes(s.suburb.toLowerCase().replace(/\s+/g, '-'))
);

const humeSuburbs = suburbs.filter((s: any) => 
  ['seymour', 'wodonga', 'albury', 'holbrook', 'gundagai', 'yass', 'goulburn', 'prestons'].includes(s.suburb.toLowerCase().replace(/\s+/g, '-'))
);

const princesWestSuburbs = suburbs.filter((s: any) => 
  ['geelong', 'colac', 'camperdown', 'warrnambool', 'portland', 'mount-gambier'].includes(s.suburb.toLowerCase().replace(/\s+/g, '-'))
);

// Fallback to all if regional arrays are sparse
const displayMetro = metroSuburbs.length > 0 ? metroSuburbs : suburbs.slice(0, 5);

