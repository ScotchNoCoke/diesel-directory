---
import Layout from "../layouts/Layout.astro";

export const prerender = false;

const reqUrl = new URL(Astro.request.url);
const status = reqUrl.searchParams.get("status");
const error = reqUrl.searchParams.get("error");
---

<Layout title="Reset Password | Diesel Hub">
  <main class="min-h-screen bg-slate-950 text-slate-100 flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl p-8 shadow-2xl">
      <div class="text-center mb-6">
        <h1 class="text-2xl font-black text-white">Reset Password</h1>
        <p class="text-xs text-slate-400 mt-2">Enter your registered workshop email address and we'll send you a password reset link.</p>
      </div>

      {status === "sent" ? (
        <div class="space-y-4">
          <div class="p-4 bg-emerald-500/10 border border-emerald-500/20 rounded-xl text-emerald-400 text-xs leading-relaxed">
            ✓ If an account exists for that email, a password reset link has been dispatched. Please check your inbox and spam folder.
          </div>
          <a
            href="/login"
            class="block text-center text-xs font-semibold text-amber-400 hover:text-amber-300 transition pt-2"
          >
            &larr; Back to Sign In
          </a>
        </div>
      ) : (
        <form method="POST" action="/api/auth/forgot-password" class="space-y-4">
          {error && (
            <div class="p-3 bg-red-500/10 border border-red-500/20 rounded-xl text-red-400 text-xs">
              {error}
            </div>
          )}

          <div>
            <label for="email" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">Registered Email</label>
            <input
              id="email"
              type="email"
              name="email"
              required
              placeholder="workshop@example.com"
              class="w-full px-4 py-3 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
            />
          </div>

          <button
            type="submit"
            class="w-full py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-xl text-sm transition shadow-lg shadow-amber-500/20 cursor-pointer"
          >
            Send Reset Link &rarr;
          </button>

          <div class="text-center pt-2">
            <a href="/login" class="text-xs text-slate-400 hover:text-slate-200 transition">
              Remember your password? Sign in
            </a>
          </div>
        </form>
      )}
    </div>
  </main>
</Layout>
