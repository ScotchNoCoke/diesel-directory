---
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';

type ContactRecord = {
  id: string;
  created_at: string;
  category: string;
  name: string;
  company_name: string | null;
  email: string;
  phone: string | null;
  message: string;
  status: string;
};

export const prerender = false;

let contacts: ContactRecord[] = [];
let error: string | null = null;

if (env.DB) {
  try {
    const { results } = await env.DB.prepare(
      'SELECT * FROM admin_contacts ORDER BY created_at DESC LIMIT 100'
    ).all<ContactRecord>();
    contacts = results || [];
  } catch (err) {
    error = err instanceof Error ? err.message : String(err);
  }
}

const newCount = contacts.filter((contact) => contact.status === 'new').length;
const resolvedCount = contacts.filter((contact) => contact.status === 'resolved').length;
const activeCount = contacts.length - resolvedCount;
---

<Layout title="Admin Centre | Contact Triage | Diesel Hub">
  <main class="min-h-screen bg-zinc-950 px-4 py-8 text-slate-100 sm:px-6 sm:py-12 lg:px-8">
    <div class="mx-auto max-w-7xl space-y-8">
      <header class="relative overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/70 p-6 shadow-2xl sm:p-8">
        <div class="absolute inset-y-0 left-0 w-1.5 bg-amber-500"></div>
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div class="space-y-3">
            <div class="inline-flex items-center gap-2 rounded border border-amber-500/20 bg-amber-500/10 px-3 py-1 font-mono text-[11px] font-bold uppercase tracking-widest text-amber-400">
              <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500"></span>
              Operations · Admin Centre
            </div>
            <div>
              <h1 class="font-mono text-2xl font-black tracking-tight text-white sm:text-3xl">
                Inbound contact triage
              </h1>
              <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-400">
                Review fleet inquiries, emergency dispatch requests, and workshop claims from across the DieselHub directory.
              </p>
            </div>
          </div>
          <div class="flex shrink-0 flex-wrap items-center gap-3">
            <button
              id="refresh-queue"
              type="button"
              class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-700 bg-slate-900 px-4 py-2.5 font-mono text-xs font-bold uppercase tracking-wide text-slate-200 transition hover:border-amber-500/50 hover:text-amber-400"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h5M20 20v-5h-5M5.6 9A7 7 0 0 1 18 6l2 3M4 15l2 3a7 7 0 0 0 12.4-3" />
              </svg>
              Refresh queue
            </button>
            <a
              href="/"
              class="inline-flex items-center gap-2 rounded-lg bg-amber-500 px-4 py-2.5 font-mono text-xs font-black uppercase tracking-wide text-zinc-950 shadow-lg shadow-amber-500/10 transition hover:bg-amber-400"
            >
              Directory
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </header>

      <section class="grid gap-4 sm:grid-cols-3" aria-label="Inbox summary">
        <div class="rounded-xl border border-slate-800 bg-slate-900/70 p-5">
          <p class="font-mono text-[11px] font-bold uppercase tracking-widest text-slate-400">New requests</p>
          <p class="mt-3 font-mono text-3xl font-black text-amber-400">{newCount}</p>
          <p class="mt-1 text-xs text-slate-500">Awaiting initial review</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/70 p-5">
          <p class="font-mono text-[11px] font-bold uppercase tracking-widest text-slate-400">Active queue</p>
          <p class="mt-3 font-mono text-3xl font-black text-white">{activeCount}</p>
          <p class="mt-1 text-xs text-slate-500">Not yet resolved</p>
        </div>
        <div class="rounded-xl border border-slate-800 bg-slate-900/70 p-5">
          <p class="font-mono text-[11px] font-bold uppercase tracking-widest text-slate-400">Resolved</p>
          <p class="mt-3 font-mono text-3xl font-black text-emerald-400">{resolvedCount}</p>
          <p class="mt-1 text-xs text-slate-500">Completed requests in this view</p>
        </div>
      </section>

      {error && (
        <div role="alert" class="rounded-xl border border-red-500/30 bg-red-500/10 p-4 text-sm text-red-300">
          <span class="font-mono font-bold uppercase tracking-wide">Queue unavailable:</span> {error}
        </div>
      )}

      <div id="admin-feedback" class="hidden rounded-xl border p-4 text-sm" role="status" aria-live="polite"></div>

      <section class="overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/70 shadow-xl">
        <div class="flex flex-col gap-2 border-b border-slate-800 px-5 py-5 sm:flex-row sm:items-end sm:justify-between sm:px-6">
          <div>
            <p class="font-mono text-[11px] font-bold uppercase tracking-widest text-amber-500">Contact queue</p>
            <h2 class="mt-1 text-lg font-bold text-white">Latest submissions</h2>
          </div>
          <p class="font-mono text-xs text-slate-500">Showing up to 100 recent requests</p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full min-w-[850px] text-left text-sm">
            <thead class="bg-slate-950/70 font-mono text-[10px] font-bold uppercase tracking-widest text-slate-400">
              <tr>
                <th scope="col" class="px-5 py-4">Received</th>
                <th scope="col" class="px-5 py-4">Category</th>
                <th scope="col" class="px-5 py-4">Contact</th>
                <th scope="col" class="px-5 py-4">Message</th>
                <th scope="col" class="px-5 py-4">Status</th>
                <th scope="col" class="px-5 py-4 text-right">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/80">
              {contacts.length === 0 ? (
                <tr>
                  <td colspan="6" class="px-5 py-16 text-center">
                    <div class="mx-auto flex max-w-sm flex-col items-center gap-3">
                      <span class="flex h-12 w-12 items-center justify-center rounded-xl border border-slate-700 bg-slate-950 font-mono text-xl text-slate-500">—</span>
                      <div>
                        <p class="font-semibold text-slate-200">The inbox is clear</p>
                        <p class="mt-1 text-sm text-slate-500">New inquiries and dispatch requests will appear here.</p>
                      </div>
                    </div>
                  </td>
                </tr>
              ) : (
                contacts.map((item) => {
                  const categoryClass =
                    item.category === 'emergency'
                      ? 'border-red-500/30 bg-red-500/10 text-red-300'
                      : item.category === 'quote_callout'
                        ? 'border-amber-500/30 bg-amber-500/10 text-amber-300'
                        : 'border-slate-700 bg-slate-800/70 text-slate-300';
                  const statusClass =
                    item.status === 'new'
                      ? 'bg-blue-500/10 text-blue-300'
                      : item.status === 'in_progress'
                        ? 'bg-amber-500/10 text-amber-300'
                        : item.status === 'resolved'
                          ? 'bg-emerald-500/10 text-emerald-300'
                          : 'bg-slate-800 text-slate-400';

                  return (
                    <tr class="transition-colors hover:bg-slate-800/40">
                      <td class="whitespace-nowrap px-5 py-4 font-mono text-xs text-slate-400">
                        {new Date(item.created_at).toLocaleString('en-AU', { timeZone: 'Australia/Melbourne' })}
                      </td>
                      <td class="px-5 py-4">
                        <span class={`inline-flex rounded-md border px-2 py-1 font-mono text-[10px] font-bold uppercase tracking-wide ${categoryClass}`}>
                          {item.category.replaceAll('_', ' ')}
                        </span>
                      </td>
                      <td class="px-5 py-4">
                        <p class="font-semibold text-slate-100">{item.name}</p>
                        {item.company_name && <p class="mt-0.5 text-xs text-slate-400">{item.company_name}</p>}
                        <div class="mt-1.5 flex flex-col items-start gap-1 font-mono text-xs">
                          <a href={`mailto:${item.email}`} class="text-amber-400 transition hover:text-amber-300 hover:underline">{item.email}</a>
                          {item.phone && <a href={`tel:${item.phone}`} class="text-slate-400 transition hover:text-slate-200">{item.phone}</a>}
                        </div>
                      </td>
                      <td class="max-w-sm px-5 py-4 text-slate-300">
                        <p class="line-clamp-2" title={item.message}>{item.message}</p>
                      </td>
                      <td class="px-5 py-4">
                        <span class={`inline-flex rounded-full px-2.5 py-1 font-mono text-[10px] font-bold uppercase tracking-wide ${statusClass}`}>
                          {item.status.replaceAll('_', ' ')}
                        </span>
                      </td>
                      <td class="px-5 py-4 text-right">
                        <button
                          type="button"
                          data-contact-id={item.id}
                          data-next-status={item.status === 'resolved' ? 'new' : 'resolved'}
                          class="contact-status-button cursor-pointer rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 font-mono text-[10px] font-bold uppercase tracking-wide text-slate-200 transition hover:border-amber-500/50 hover:text-amber-300 disabled:cursor-wait disabled:opacity-50"
                        >
                          {item.status === 'resolved' ? 'Reopen' : 'Resolve'}
                        </button>
                      </td>
                    </tr>
                  );
                })
              )}
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </main>

  <script>
    const refreshButton = document.querySelector<HTMLButtonElement>('#refresh-queue');
    const feedback = document.querySelector<HTMLDivElement>('#admin-feedback');

    refreshButton?.addEventListener('click', () => window.location.reload());

    document.querySelectorAll<HTMLButtonElement>('.contact-status-button').forEach((button) => {
      button.addEventListener('click', async () => {
        const { contactId, nextStatus } = button.dataset;
        if (!contactId || !nextStatus || !feedback) return;

        button.disabled = true;
        feedback.className = 'rounded-xl border border-amber-500/30 bg-amber-500/10 p-4 text-sm text-amber-300';
        feedback.textContent = 'Updating contact status…';

        try {
          const response = await fetch('/api/admin/contacts', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: contactId, status: nextStatus }),
          });

          if (!response.ok) {
            throw new Error(`Status update failed (${response.status}). Please try again.`);
          }

          window.location.reload();
        } catch (error) {
          feedback.className = 'rounded-xl border border-red-500/30 bg-red-500/10 p-4 text-sm text-red-300';
          feedback.textContent = error instanceof Error ? error.message : 'Unable to update the contact status.';
          button.disabled = false;
        }
      });
    });
  </script>
</Layout>
