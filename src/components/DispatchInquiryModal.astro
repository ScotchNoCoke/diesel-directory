---
---
<div
  id="dispatchModal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modalTitle"
>
  <div class="relative w-full max-w-lg rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl p-6 sm:p-8 space-y-6">
    <!-- Header -->
    <div class="flex items-start justify-between gap-4 border-b border-slate-800/80 pb-4">
      <div>
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20 mb-1">
          ⚡ Direct Workshop Dispatch
        </span>
        <h3 id="modalTitle" class="text-xl font-bold text-white tracking-tight">Request Callout / Service Quote</h3>
        <p id="modalSub" class="text-xs text-slate-400 mt-1">Directly notify the on-call diesel mechanic at <span id="targetBizName" class="text-amber-400 font-semibold"></span>.</p>
      </div>
      <button
        type="button"
        id="closeModalBtn"
        class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-slate-800 transition cursor-pointer text-lg"
        aria-label="Close"
      >
        ✕
      </button>
    </div>

    <!-- Alert Box -->
    <div id="modalAlert" class="hidden p-3 rounded-xl text-xs font-medium"></div>

    <!-- Form -->
    <form id="dispatchForm" class="space-y-4">
      <input type="hidden" name="business_id" id="modalBizId" value="" />

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="driver_name" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
            Your Name / Driver *
          </label>
          <input
            type="text"
            id="driver_name"
            name="driver_name"
            required
            placeholder="e.g. John Mitchell"
            class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white placeholder-slate-600 text-xs focus:ring-2 focus:ring-amber-500 focus:outline-none"
          />
        </div>

        <div>
          <label for="driver_phone" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
            Mobile / Contact Phone *
          </label>
          <input
            type="tel"
            id="driver_phone"
            name="driver_phone"
            required
            placeholder="e.g. 0400 123 456"
            class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white placeholder-slate-600 text-xs focus:ring-2 focus:ring-amber-500 focus:outline-none"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="vehicle_type" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
            Vehicle / Combination
          </label>
          <select
            id="vehicle_type"
            name="vehicle_type"
            class="w-full px-3 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-slate-200 text-xs focus:ring-2 focus:ring-amber-500 focus:outline-none"
          >
            <option value="Semi Trailer / Prime Mover">Semi Trailer (Single)</option>
            <option value="B-Double Combination">B-Double</option>
            <option value="Road Train (A/B Triples)">Road Train</option>
            <option value="Heavy Rigid (HR)">Heavy Rigid Truck</option>
            <option value="Medium / Light Rigid">Medium / Light Truck</option>
            <option value="Bus / Coach">Bus / Coach</option>
            <option value="Trailer Only">Trailer Only</option>
          </select>
        </div>

        <div>
          <label for="breakdown_location" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
            Location / Highway Bay
          </label>
          <input
            type="text"
            id="breakdown_location"
            name="breakdown_location"
            placeholder="e.g. Hume Hwy BP rest bay, Wallan"
            class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white placeholder-slate-600 text-xs focus:ring-2 focus:ring-amber-500 focus:outline-none"
          />
        </div>
      </div>

      <div>
        <label for="issue_description" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
          Fault Details / Work Required *
        </label>
        <textarea
          id="issue_description"
          name="issue_description"
          rows="3"
          required
          placeholder="e.g. Air system fault on trailer axle, red dash fault code active, needing roadside technician."
          class="w-full px-3.5 py-2.5 bg-slate-950 border border-slate-800 rounded-xl text-white placeholder-slate-600 text-xs focus:ring-2 focus:ring-amber-500 focus:outline-none"
        ></textarea>
      </div>

      <div class="flex items-center justify-end gap-3 pt-2">
        <button
          type="button"
          id="cancelModalBtn"
          class="px-4 py-2.5 rounded-xl border border-slate-800 text-slate-300 hover:bg-slate-800 text-xs font-medium cursor-pointer transition"
        >
          Cancel
        </button>
        <button
          type="submit"
          id="submitModalBtn"
          class="px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold shadow-lg shadow-amber-500/20 cursor-pointer transition flex items-center gap-1.5"
        >
          <span>Send Dispatch Request</span>
          <span>&rarr;</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  const modal = document.getElementById("dispatchModal");
  const form = document.getElementById("dispatchForm") as HTMLFormElement;
  const bizIdInput = document.getElementById("modalBizId") as HTMLInputElement;
  const bizNameSpan = document.getElementById("targetBizName");
  const alertBox = document.getElementById("modalAlert");
  const closeBtn = document.getElementById("closeModalBtn");
  const cancelBtn = document.getElementById("cancelModalBtn");
  const submitBtn = document.getElementById("submitModalBtn");

  function openModal(bizId: string, bizName: string) {
    if (!modal) return;
    if (bizIdInput) bizIdInput.value = bizId;
    if (bizNameSpan) bizNameSpan.textContent = bizName || bizId;
    if (alertBox) alertBox.className = "hidden";
    if (form) form.reset();
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
  }

  // Global event listener for button triggers
  document.addEventListener("click", (e) => {
    const target = (e.target as HTMLElement).closest(".trigger-dispatch-modal");
    if (target) {
      const bizId = target.getAttribute("data-biz-id") || "";
      const bizName = target.getAttribute("data-biz-name") || "";
      openModal(bizId, bizName);
    }
  });

  closeBtn?.addEventListener("click", closeModal);
  cancelBtn?.addEventListener("click", closeModal);

  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!submitBtn || !alertBox) return;

    submitBtn.setAttribute("disabled", "true");
    submitBtn.innerHTML = "Sending request...";

    try {
      const formData = new FormData(form);
      const res = await fetch("/api/inquiries/create", {
        method: "POST",
        body: formData,
      });

      const data: unknown = await res.json();
      const responseData =
        typeof data === 'object' && data !== null
          ? data as { success?: boolean; error?: string }
          : {};

      if (res.ok && responseData.success) {
        alertBox.className = "p-3 rounded-xl text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20";
        alertBox.textContent = "✓ Breakdown request dispatched! The workshop has received your details.";
        form.reset();
        setTimeout(() => closeModal(), 2200);
      } else {
        alertBox.className = "p-3 rounded-xl text-xs font-medium bg-red-500/10 text-red-400 border border-red-500/20";
        alertBox.textContent = "✕ " + (responseData.error || "Failed to dispatch request. Please try calling directly.");
      }
    } catch (err) {
      alertBox.className = "p-3 rounded-xl text-xs font-medium bg-red-500/10 text-red-400 border border-red-500/20";
      alertBox.textContent = "✕ Network error. Please dial the workshop directly.";
    } finally {
      submitBtn.removeAttribute("disabled");
      submitBtn.innerHTML = "Send Dispatch Request &rarr;";
    }
  });
</script>