---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "DieselHub | Heavy Transport & Linehaul Breakdown Directory",
	description = "24/7 heavy vehicle breakdown directory and NHVR combination access staging across Australian freight corridors.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth bg-zinc-950 text-slate-100 antialiased">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />

		<link rel="icon" href="/favicon.ico" />
		<link rel="manifest" href="/manifest.webmanifest" />

		<meta name="theme-color" content="#09090B" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
	</head>
	<body class="min-h-screen flex flex-col bg-zinc-950 font-sans selection:bg-amber-500 selection:text-zinc-950">
		<!-- Sticky Top Navigation -->
		<header class="sticky top-0 z-50 bg-zinc-950/95 backdrop-blur border-b border-zinc-800">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
				<!-- Brandmark Logo -->
				<a href="/" class="flex items-center gap-3.5 group py-1" aria-label="DieselHub Home">
					<div class="h-11 w-11 sm:h-12 sm:w-12 rounded-lg bg-amber-500 flex items-center justify-center font-mono font-black text-zinc-950 text-2xl tracking-tighter shadow-md shadow-amber-500/20 group-hover:bg-amber-400 transition-colors">
						DH
					</div>
					<div class="flex flex-col justify-center">
						<span class="font-mono font-black text-2xl sm:text-3xl tracking-tight text-slate-100 group-hover:text-amber-400 transition-colors leading-none">DIESEL<span class="text-amber-500">HUB</span></span>
						<span class="text-[10px] sm:text-[11px] font-mono font-bold tracking-widest text-slate-400 uppercase mt-1">
							Heavy Transport Index
						</span>
					</div>
				</a>

				<div class="flex items-center gap-3">
					<div class="hidden lg:flex items-center gap-2 text-xs font-mono text-slate-400 bg-zinc-900/90 px-3 py-1.5 rounded border border-zinc-800">
						<span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
						<span>CORRIDOR DISPATCH ACTIVE</span>
					</div>

					<a
						href="#emergency-finder"
						class="inline-flex items-center gap-1.5 bg-amber-500 hover:bg-amber-400 text-zinc-950 font-mono font-black text-xs uppercase tracking-wider px-3.5 sm:px-4 py-2.5 rounded shadow-lg shadow-amber-500/10 transition-colors"
					>
						<span>Emergency Dispatch</span>
					</a>
				</div>
			</div>

			<div class="h-1 w-full bg-hazard-stripes opacity-90"></div>
		        <a href="/contact" class="px-3 py-1.5 rounded bg-neutral-900 hover:bg-neutral-800 text-neutral-300 hover:text-amber-400 border border-neutral-700/80 font-mono text-xs font-semibold uppercase tracking-wider transition shadow-sm">Contact Us</a>
          <a 
          href="/login" 
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-300 hover:text-amber-400 border border-slate-800 hover:border-amber-500/40 bg-slate-900/60 transition"
        >
          <svg class="w-3.5 h-3.5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
          </svg>
          Workshop Sign In
        </a>
      
    </header>

		<!-- Main Content Area -->
		<main class="flex-1">
			<slot />
		</main>

		<!-- Footer -->
		<footer class="bg-zinc-900 border-t border-zinc-800 mt-20">
			<div class="h-1 w-full bg-hazard-stripes opacity-40"></div>
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
				<p class="text-xs text-slate-400 font-mono">
					&copy; {new Date().getFullYear()} DieselHub. Heavy Vehicle &amp; Linehaul Breakdown Directory.
				</p>
				<div class="flex flex-wrap gap-2 text-[11px] font-mono text-slate-400">
					<span class="px-2 py-0.5 rounded bg-zinc-950 border border-zinc-800">26m B-Double</span>
					<span class="px-2 py-0.5 rounded bg-zinc-950 border border-zinc-800">36m Road Train</span>
					<span class="px-2 py-0.5 rounded bg-zinc-950 border border-zinc-800 text-amber-500/90">NHVR Verified</span>
				</div>
			</div>
		</footer>
	</body>
</html>
