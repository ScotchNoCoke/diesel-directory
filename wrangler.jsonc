{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "diesel-directory",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "diesel-directory",
			"database_id": "9b4abe65-ea60-4dbb-a0c2-3a454e7d8c32"
		}
	]
}